# ----------------------------------------------------------------------
# .htaccess — praveshsingh.com
# Canonicalization, 301 Redirects, Real 404, /build/ Block,
# /writing Canonicalization, Security Headers
# ----------------------------------------------------------------------

# Prevent directory listing without throwing 403 when index file is requested
Options -Indexes

# Set default directory index
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Enforce HTTPS & Canonical Domain (non-www)
  # Redirects http://, http://www., and https://www. to https://praveshsingh.com
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.praveshsingh\.com$ [NC]
  RewriteRule ^(.*)$ https://praveshsingh.com/$1 [R=301,L]

  # 2. Canonicalize root /index.html -> /
  # Prevents GSC "Page with redirect" on /index.html (Google discovers it separately)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html(?:\?[^\\ ]*)?\ HTTP/ [NC]
  RewriteRule ^index\.html$ https://praveshsingh.com/ [R=301,L]

  # 3. Canonicalize /writing/index.html -> /writing/
  # Prevents duplicate content between /writing/ and /writing/index.html
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /writing/index\.html(?:\?[^\\ ]*)?\ HTTP/ [NC]
  RewriteRule ^writing/index\.html$ https://praveshsingh.com/writing/ [R=301,L]

  # 4. Hard-block the local build mirror BEFORE any other rule.
  # Returns 404 (not 403) so GSC treats it as a normal absent URL —
  # a 403 creates a "Blocked due to access forbidden (403)" coverage issue.
  RewriteRule ^build(/.*)?$ - [R=404,L]

  # 5. Redirect direct directory requests that lack index files to homepage
  # Prevents 403 Forbidden from Options -Indexes (e.g. /images/subdir/)
  # IMPORTANT: Exclude root / to prevent infinite redirect loop on homepage
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !^/$ [NC]
  RewriteCond %{REQUEST_URI} !^/(writing|\.well-known)/?$ [NC]
  RewriteRule ^ https://praveshsingh.com/ [R=301,L]

  # 6. Canonicalize /writing -> /writing/ (single canonical form for the hub)
  RewriteRule ^writing$ https://praveshsingh.com/writing/ [R=301,L]

</IfModule>

# Block /build/ at the access level too (defence in depth)
<FilesMatch "^(?i)\.htaccess$">
  Require all denied
</FilesMatch>
# NOTE: /build/ returns 404 via mod_rewrite above. Do NOT use "Require all denied"
# here — Apache issues 403 for it, which GSC reports as a coverage error.

# Real 404 handler (returns HTTP 404 + noindex page — no more soft 404s)
ErrorDocument 404 /404.html

# MIME Types & UTF-8 Encoding
<IfModule mod_mime.c>
  AddType text/markdown .md
  AddType text/plain .txt
  AddType application/json .json
  AddType application/xml .xml
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddCharset UTF-8 .html .md .txt .json .xml
</IfModule>

# Security & Cache Control Headers
<IfModule mod_headers.c>
  # Protect against clickjacking and MIME-sniffing
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HSTS — force HTTPS for all subdomains for 1 year
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # CSP in report-only mode first — tighten after reviewing reports
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://www.googletagmanager.com; base-uri 'self'; form-action 'self'"

  # Keep /build/ out of indexes even if the rewrite is bypassed
  <If "%{REQUEST_URI} -strmatch '/build*'">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>

  # Ensure robots.txt, sitemap.xml, llms.txt are accessible to all AI/Search bots
  <FilesMatch "\.(txt|xml|md)$">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Cache static image assets for 1 year
  <FilesMatch "\.(png|webp|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cache HTML for 1 hour with revalidation
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# Compression for fast delivery
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
